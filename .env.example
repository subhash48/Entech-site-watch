# Vercel environment variables for the single-URL deployment (Project Settings -> Environment Variables).
# Vercel Services share one set of project variables; only the FastAPI service reads these.
# Never commit real values. For local development use backend/.env.example and frontend/.env.example.

# Required for SiteWatch AI. Server-side only: never prefix it with NEXT_PUBLIC_.
# Without it the dashboard still works and the assistant shows a setup message (HTTP 503).
ANTHROPIC_API_KEY=

# Optional (these are the defaults).
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=45
AI_MAX_TOOL_ITERATIONS=5

# Do NOT set on Vercel:
# NEXT_PUBLIC_API_BASE_URL  (unset = same-origin /api/* requests, routed by vercel.json)
# CORS_ORIGINS / CORS_ORIGIN_REGEX  (same origin, CORS not needed)
