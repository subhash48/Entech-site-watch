# Vercel environment variables for the single-URL deployment (Project Settings -> Environment Variables).
# Vercel Services share one set of project variables; only the FastAPI service reads these.
# Never commit real values. For local development use backend/.env.example and frontend/.env.example.
# All of these are server-side only: never prefix them with NEXT_PUBLIC_.

# --- SiteWatch AI ---
# Without a key the dashboard still works and the assistant shows a setup message (HTTP 503).
# Option A: Groq (OpenAI-compatible API, official groq SDK)
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Option B: Anthropic (Claude)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Optional (these are the defaults).
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=45
AI_MAX_TOOL_ITERATIONS=5

# --- Dataset uploads (Data Management page) ---
# PostgreSQL connection string for durable, versioned dataset storage, e.g. from Vercel Marketplace (Neon,
# Supabase) or your own server: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Without it the dashboard serves the committed starter dataset and activation is disabled.
DATABASE_URL=
# Administrator token for uploading and activating datasets (at least 16 random characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Do NOT set on Vercel:
# NEXT_PUBLIC_API_BASE_URL  (unset = same-origin /api/* requests, routed by vercel.json)
# CORS_ORIGINS / CORS_ORIGIN_REGEX  (same origin, CORS not needed)
# SQLITE_PATH  (SQLite is local-development storage only and is never used on Vercel)
