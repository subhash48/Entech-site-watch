# Copy to frontend/.env.local for local development (git-ignored).
# Base URL of the FastAPI backend, without a trailing slash.
# This value is public: it is embedded in the browser bundle. Never put secrets or API keys here.
# The AI provider key belongs only in the backend environment.
#
# On Vercel (Services, single URL): do NOT set this variable. The frontend then calls /api/* on its
# own origin and vercel.json routes those requests to the FastAPI service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
