# Backend environment. Copy to backend/.env for local use (that file is git-ignored),
# or set these in your host's environment settings. Never commit real keys.
#
# On Vercel: set AI_PROVIDER and the matching API key (and optionally the AI_* values) in Project
# Settings -> Environment Variables. Do not set CORS_* or ENVIRONMENT there: the frontend and API share
# one origin (no CORS needed) and ENVIRONMENT falls back to Vercel's VERCEL_ENV.

# --- SiteWatch AI (optional) ---
# Without a key, the dashboard works fully and the assistant shows a setup message.
# AI_PROVIDER: anthropic (Claude) or groq (OpenAI-compatible API).
AI_PROVIDER=anthropic
# Anthropic: create a key at https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=
# Groq: create a key at https://console.groq.com/keys, then set AI_PROVIDER=groq.
GROQ_API_KEY=
# Model for the chosen provider. Defaults: claude-opus-5-5 (anthropic), openai/gpt-oss-120b (groq).
# GROQ_MODEL is also accepted when AI_PROVIDER=groq and AI_MODEL is not set.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=45
AI_MAX_TOOL_ITERATIONS=5

# --- CORS ---
# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Only needed when the frontend runs on a different origin (local dev: port 3100 -> 8001).
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Optional regex for preview deployments.
CORS_ORIGIN_REGEX=

ENVIRONMENT=development

# --- Data (defaults to backend/data/*) ---
# DATA_DIR=./data
# READINGS_PATH=./data/readings.csv
# THRESHOLDS_PATH=./data/thresholds.json
# Comma-separated files/folders indexed for the assistant's documentation search.
# DOCS_PATHS=../README.md,../docs
